<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TowerDefense.App.MainWindow"
        Title="Tower Defense"
        Width="600"
        Height="455">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Tower Defense" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="D = départ · B = base · Gris = chemin · Vert = constructible"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="MapPanel" HorizontalAlignment="Center" />
    </StackPanel>
</Window>